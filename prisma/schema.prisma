// -------------------------------------------------------------
//  Prisma Generator + Datasource
// -------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
//  User Table
// -------------------------------------------------------------
model User {
  id        String        @id @default(cuid())
  email     String        @unique
  username  String        @unique
  password  String
  createdAt DateTime      @default(now())

  // Relations
  messages  Message[]
  rooms     RoomMember[]   // NEW: users can join many rooms
}

// -------------------------------------------------------------
//  Room Table
// -------------------------------------------------------------
model Room {
  id        String        @id @default(cuid())
  name      String?       // null = DM room, not group
  isGroup   Boolean       @default(false)
  createdAt DateTime      @default(now())

  // Relations
  messages  Message[]
  members   RoomMember[]
}

// -------------------------------------------------------------
//  RoomMember Table (join table User <-> Room)
// -------------------------------------------------------------
model RoomMember {
  id        String    @id @default(cuid())
  userId    String
  roomId    String
  joinedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])  // a user can join a room only once
}

// -------------------------------------------------------------
//  Message Table
// -------------------------------------------------------------
model Message {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
}
